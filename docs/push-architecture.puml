@startuml push-architecture
title 推播系統架構流程

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans TC"
skinparam rectangle {
  BackgroundColor #F3F5F9
  BorderColor #CBD5E1
  FontColor #1E2336
}
skinparam queue {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
  FontColor #1E2336
}
skinparam database {
  BackgroundColor #D1FAE5
  BorderColor #059669
  FontColor #1E2336
}
skinparam ArrowColor #64748B

rectangle "Stage 1 ─ 觸發來源" as S1 {
  rectangle "手動推播" as T1
  rectangle "排程推播" as T2
  rectangle "系統推播" as T3
}

queue "GCP Pub/Sub" as MQ

rectangle "Stage 2 ─ 資料處理" as S2 {
  rectangle "資料落地" as P1
  rectangle "資料清洗" as P2
  rectangle "寫入 MemoryStore" as P3
}

database "MemoryStore" as CACHE

rectangle "Stage 3 ─ 推送分流" as S3 {
  rectangle "Sub fan-out" as F1
  rectangle "離線推播" as D1
  rectangle "WebSocket 推播\n（含分組）" as D2
}

T1 --> MQ
T2 --> MQ
T3 --> MQ

MQ --> P1
P1 --> P2
P2 --> P3

P3 --> CACHE
CACHE --> F1

F1 --> D1
F1 --> D2

@enduml
